{
  "name": "nodetick",
  "version": "0.3.0",
  "private": true,
  "description": "Self-hosted TickTick-compatible server on Cloudflare Workers + a matching CLI",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "worker",
    "cli",
    "webapp"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "node tests/e2e/run-all.mjs",
    "dev": "npm run dev -w worker",
    "deploy": "npm run deploy -w worker",
    "type-check": "npm run type-check --workspaces --if-present"
  },
  "engines": {
    "node": ">=20"
  }
}
